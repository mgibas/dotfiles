{
  "permissions": {
    "defaultMode": "auto"
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.config/herdr/hooks/tab-title.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/worktree-fast-forward.sh",
            "timeout": 60,
            "statusMessage": "Fast-forwarding worktree to origin"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/require-worktree.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/status-line.sh",
    "refreshInterval": 30
  },
  "outputStyle": "No BS",
  "alwaysThinkingEnabled": true,
  "env": {
    "CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION": "1",
    "FORCE_HYPERLINK": "1"
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "tui": "fullscreen",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
